# ============================================================================
# Backend Catálogo TiendaSheis — variables de entorno (EJEMPLO, sin valores reales).
# Copia este archivo a `.env` y rellena tus propios valores. NUNCA subas `.env`.
# En producción se pasan como variables de entorno del contenedor/servicio.
# ============================================================================

# --- Base de datos (PostgreSQL / Supabase: usa la cadena del pooler con sslmode=require) ---
DB_URL=jdbc:postgresql://db.example.com:5432/sheis_catalogo?sslmode=require
DB_USER=usuario_bd
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- Seguridad JWT ---
# Obligatorio, mínimo 32 caracteres. NO uses valores de ejemplo. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=PEGA_AQUI_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
# Caducidad del token en minutos (por defecto 480 = 8 horas).
JWT_EXPIRATION_MINUTES=480

# --- Administrador inicial (solo se crea si la tabla de usuarios está vacía) ---
# ADMIN_PASSWORD debe tener al menos 10 caracteres.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN

# --- Restablecimiento opcional de la contraseña del admin (usar una sola vez) ---
# Si es true, al arrancar se actualiza la contraseña del admin cuyo correo sea
# ADMIN_EMAIL (si no existe, se crea). Elimínalo o ponlo en false después de usarlo.
ADMIN_RESET_PASSWORD=false

# --- CORS: orígenes del frontend, separados por comas. En prod es obligatorio. ---
CORS_ORIGINS=https://tudominio.com

# --- Proxy inverso ---
# Activar SOLO detrás de un proxy de confianza (nginx/Traefik/balanceador) que
# sobrescriba X-Forwarded-For. Déjalo en false si el backend recibe tráfico directo.
TRUST_FORWARDED_HEADERS=false

# --- Perfil de Spring y puerto ---
# Usar "prod" en producción (desactiva Swagger, endurece errores y logs).
SPRING_PROFILES_ACTIVE=prod
# Puerto de escucha (el perfil prod usa ${PORT:8082}). En desarrollo se puede usar SERVER_PORT.
PORT=8082
